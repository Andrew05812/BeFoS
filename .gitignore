# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets / environment ---
# `.env.*` already covers .env.local, .env.production.local and friends; `*.env` catches
# the other spelling (prod.env), which the two rules above would let through.
.env
.env.*
*.env
!.env.example

# --- Android / Gradle ---
.gradle/
.kotlin/
local.properties
*.iml
.idea/
.DS_Store
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.keystore
# No negation for debug.keystore on purpose: a whitelisted keystore is exactly the file
# that must not be committed, and nothing in this project needs one in the tree.
keystore.properties
!keystore.properties.example
/android/app/release/

# --- Node (если появится тулинг) ---
node_modules/

# --- Logs ---
*.log
app.log
*.hprof

# --- Local scratch and dumps ---
# `*.dump` and `*.sqlite` are here because a database dump is the one artifact that can be
# committed by accident while someone is checking OPERATIONS.md, and it carries real rows.
/tmp/
*.dump
*.sqlite
/.qoder/
/uploads/

# --- Generated seed uploads (regenerated by `python -m app.seed`) ---
backend/uploads/*
!backend/uploads/.gitkeep

# --- Local working journal ---
# CONTINUATION.md is a machine-specific handover note (local paths, scratch commands). It stays
# out of the published tree, but not out of history: the commits that carried it are the
# development record. docs/DEVELOPMENT_HISTORY.md is the published form of that record.
CONTINUATION.md
