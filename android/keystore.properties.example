# Copy to android/keystore.properties (outside git) and fill with real values
# to make assembleRelease/bundleRelease produce a signed artifact.
# Generate a key with:
#   keytool -genkeypair -v -keystore befos-release.keystore -alias befos \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=../befos-release.keystore
storePassword=CHANGE_ME
keyAlias=befos
keyPassword=CHANGE_ME
