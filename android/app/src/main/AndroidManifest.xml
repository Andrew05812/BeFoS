<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The pair's hour is reminded by this device, on this device: no messaging service is
         contacted and no key is held, so the only permission asked for is the right to show the
         notice the person already agreed to by arranging the hour. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BeFoSApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeFoS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BeFoS"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Stage 132: the personal door. `befos://invite/<code>` is opened from a shared
                 message; the code travels in the body of the preview call, never again in a server
                 path, so a forwarded link is a door and not a search key for a profile. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="befos" android:host="invite" />
            </intent-filter>
        </activity>

        <!-- The alarm the pair's hour sets wakes this receiver; nothing outside the app may ask it to. -->
        <receiver
            android:name=".core.notifications.PlanReminderReceiver"
            android:exported="false" />
    </application>

</manifest>
