# --- Application ---
APP_NAME=BeFoS
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Database ---
POSTGRES_USER=befos
POSTGRES_PASSWORD=befos_password
POSTGRES_DB=befos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Used by the app. In Docker Compose the host is the `postgres` service.
# For local runs outside Docker use: postgresql+asyncpg://befos:befos_password@localhost:5432/befos
DATABASE_URL=postgresql+asyncpg://befos:befos_password@postgres:5432/befos

# --- Security / JWT ---
JWT_SECRET=change-me-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:8000,http://10.0.2.2:8000

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=5

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Demo mode ---
DEMO_ENABLED=true
DEMO_EMAIL=demo@befos.app
DEMO_PASSWORD=Demo12345
