# --- Application ---
APP_NAME=BeFoS
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Database ---
POSTGRES_USER=befos
POSTGRES_PASSWORD=befos_password
POSTGRES_DB=befos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Used by the app. In Docker Compose the host is the `postgres` service.
# For local runs outside Docker use: postgresql+asyncpg://befos:befos_password@localhost:5432/befos
DATABASE_URL=postgresql+asyncpg://befos:befos_password@postgres:5432/befos

# --- Security / JWT ---
JWT_SECRET=change-me-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Page links (cursor signing) ---
# The key that seals "continue from here" in the four paged reads (deck, incoming taps, own taps,
# passes, pairs). It is a separate secret from the two JWT keys on purpose: a page link is handed out
# on every scroll and only names a place in one reader's own list, so sharing a key with the tokens
# would rotate both together, and a leaked signing key would become a token-forgery key.
# ENVIRONMENT=production refuses the placeholder below, a key shorter than 32 characters, and a key
# equal to either JWT secret. Generate one apart from the rest: python -c "import secrets;print(secrets.token_urlsafe(48))"
CURSOR_SECRET=change-me-cursor-secret-min-32-chars
# Which secret sealed a link. The id travels inside the link, so a rotation is auditable without the
# server remembering anything: keep it short (16 characters at most).
CURSOR_KEY_ID=a
# The key a rotation retired, still accepted until the links it sealed age out on their own. Both
# halves come as a pair, the ids must differ, and dropping them is the second step of a rotation —
# see docs/OPERATIONS.md.
CURSOR_SECRET_PREVIOUS=
CURSOR_KEY_ID_PREVIOUS=
# How long a link stays valid, in minutes (1..1440, default 720 = 12 h). A link is minted in one
# window and read in the next, so its real life is between one and two of these.
CURSOR_LINK_MINUTES=720

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:8000,http://10.0.2.2:8000

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=5

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
# Whose address a window is counted for. Leave false unless a reverse proxy in front of the app
# really overwrites X-Forwarded-For: with a false claim of trust a caller writes its own header
# and buys a fresh window per identity (measured: 300 answers against a 120/minute ceiling).
# Behind a real proxy, set it true — otherwise every visitor of the site shares one window.
TRUST_PROXY_HEADERS=false

# --- Demo mode ---
DEMO_ENABLED=true
DEMO_EMAIL=demo@befos.app
DEMO_PASSWORD=Demo12345

# --- The letter channel (стадия 131) ---
# Как письмо с кодом уходит с сервера. `outbox` — development default: письмо кладётся в каталог
# на хосте, и это честно: ничего никуда не доставляется. `smtp` — настоящая сессия SMTP на
# стандартной библиотеке, без новых зависимостей. В проде `outbox` отвергается на старте: сервер,
# который отвечает «код отправлен» и складывает письма в папку, объявляет возможность, которой у
# него нет (тот же аргумент, что у DEMO_ENABLED и плейсхолдер-секретов выше).
#
# Подключать почтовый сервис решает владелец: адрес, порт и учётная запись не хранятся в этом
# файле — он публикуется. Значения приходят из окружения развертывания (или из секрет-хранилища
# хоста), а сюда записывается только имя переменной.
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=./outbox
MAIL_FROM=no-reply@befos.local
MAIL_LINK_BASE=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_STARTTLS=true
# Сколько минут код возврата слова принимается. Границы 5..180 проверяются на старте: меньше пяти
# человек не успевает прочитать с одного экрана и набрать на другом, больше трёх часов — это дверь,
# оставленная открытой на ящик, который может быть общим.
RESET_CODE_MINUTES=30
# The prefix a personal invitation link is printed under. `befos://invite` is the scheme the
# Android client declares while the product has no web front door; an https address belongs here
# only after the owner has a page that really opens.
INVITE_LINK_BASE=befos://invite
# Сколько минут код подтверждения адреса принимается. Дольше, чем код возврата слова: письмо ждёт
# человека, который зарегистрировался и вернулся к своим делам, а не того, кто сидит у экрана.
CONFIRM_CODE_MINUTES=60
